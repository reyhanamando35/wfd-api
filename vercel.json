{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.9.0" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(favicon\\.ico|robots\\.txt|assets/.+)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/up-db",
      "schedule": "0 3 * * *"
    }
  ]
}
